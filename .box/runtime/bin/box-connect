#!/usr/bin/env bash
# FRAMEWORK FILE. Wires every installed agent to agentmemory (hooks) and to
# every server in mcp.json. Idempotent: runs on each container start and on
# `./dev connect`.
set -uo pipefail

ws=${1:-/workspace}

declare -A memory_adapter=([claude]=claude-code [codex]=codex [agy]=antigravity-cli)
# agentmemory detects agy by this dir, which agy only creates on first run.
mkdir -p "$HOME/.gemini/antigravity-cli"

if command -v agentmemory >/dev/null; then
  for bin in claude codex agy; do
    command -v "$bin" >/dev/null || continue
    log=/tmp/box-connect-$bin.log
    if agentmemory connect "${memory_adapter[$bin]}" --with-hooks --force </dev/null >"$log" 2>&1; then
      echo "[box] agentmemory hooks -> $bin"
    else
      echo "[box] warning: agentmemory connect ${memory_adapter[$bin]} failed (see $log)" >&2
    fi
  done
fi

# Runs after agentmemory so mcp.json wins for servers both define.
node /opt/box/lib/mcp-sync.mjs "$ws"
