# Copied to .env by `./dev up`. .env is gitignored; never commit secrets.

# Where global state lives: agent logins, agentmemory data, SSH keys.
# Default: ~/.agent-devbox (Windows: %USERPROFILE%\.agent-devbox)
# DEVENV_HOME=

# Compose project / container name. Default: this folder's name.
# BOX_PROJECT=

# API keys. Leave empty if you log in with OAuth inside the container
# (`claude`, `codex login`, `agy`); logins persist in DEVENV_HOME.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Used by gh, the GitHub MCP server and `./dev update` (private template).
GITHUB_TOKEN=
# Optional; context7 works without it at a lower rate limit.
CONTEXT7_API_KEY=

# Remote-SSH access for editors other than VS Code (Antigravity, Cursor, Zed...).
ENABLE_SSH=false
SSH_PORT=2222
