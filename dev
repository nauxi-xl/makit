#!/usr/bin/env bash
# shellcheck disable=SC2317,SC2329 # cmd_* run via "cmd_$cmd" (SC2317 before 0.11, SC2329 from 0.11)
# FRAMEWORK FILE. Host CLI for the devbox (PowerShell twin: dev.ps1).
# Kept thin on purpose: it resolves paths, writes .box/.env and drives
# docker. Everything else runs inside the container (/opt/box/bin).
set -euo pipefail

# Git Bash: pass container paths (/workspace, /src) through untouched.
export MSYS_NO_PATHCONV=1

# Docker Desktop on Windows wants C:/... paths; Git Bash gives /c/...
host_path() { if command -v cygpath >/dev/null; then cygpath -m "$1"; else echo "$1"; fi; }

ROOT=$(host_path "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)")
NETWORK=agent-devbox
NIX_CACHE_VOLUME=agent-devbox-nix-cache
MEMORY_PROJECT=agent-devbox-memory

usage() {
  cat <<'EOF'
Usage: ./dev <command>

  up [--code]   Build, start the shared memory server and the dev container
  shell         Open a bash shell in the dev container
  code          Open VS Code inside the dev container
  down          Stop and remove the dev container (memory server keeps running)
  rebuild       Rebuild images with the latest agents, recreate the container
  update        Pull the latest framework files from the template repo
  init <path>   Copy this template into an existing project
EOF
}

die() { echo "dev: $*" >&2; exit 1; }
info() { echo "[dev] $*"; }

# Reads KEY from .env without sourcing it; empty (not fatal) if unreadable.
env_get() { [ -f "$ROOT/.env" ] || return 0; sed -n "s/^$1=//p" "$ROOT/.env" | tail -n1 | tr -d '\r' || true; }

slug() { echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]/-/g; s/^-*//'; }

# Resolves settings into .box/.env (read by compose, so VS Code sees the
# same values) and prepares DEVENV_HOME.
prepare() {
  command -v docker >/dev/null || die "docker not found"
  [ -f "$ROOT/.env" ] || { cp "$ROOT/.env.example" "$ROOT/.env"; info "created .env from .env.example"; }

  local home project uid=1000 gid=1000
  home=$(env_get DEVENV_HOME)
  home=${home:-$HOME/.agent-devbox}
  home=${home/#\~/$HOME}
  project=$(env_get BOX_PROJECT)
  project=$(slug "${project:-$(basename "$ROOT")}")
  if [ "$(uname -s)" = Linux ]; then uid=$(id -u); gid=$(id -g); fi

  mkdir -p "$home"/credentials/{claude,codex,gemini,gh} "$home/agentmemory" "$home/ssh" "$ROOT/.box/state"
  if ! grep -qs '^AGENTMEMORY_SECRET=.' "$home/.env"; then
    echo "AGENTMEMORY_SECRET=$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')" >> "$home/.env"
    info "generated AGENTMEMORY_SECRET in $home/.env"
  fi

  cat > "$ROOT/.box/.env" <<EOF
# Generated by ./dev; do not edit (change .env instead).
BOX_PROJECT=$project
BOX_BASE_IMAGE=agent-devbox-base:$project
BOX_IMAGE=agent-devbox:$project
DEVENV_HOME=$(host_path "$home")
USER_UID=$uid
USER_GID=$gid
SSH_PORT=$(env_get SSH_PORT)
EOF

  export BOX_PROJECT=$project BOX_BASE_IMAGE=agent-devbox-base:$project \
    BOX_IMAGE=agent-devbox:$project USER_UID=$uid USER_GID=$gid

  docker network inspect "$NETWORK" >/dev/null 2>&1 || docker network create "$NETWORK" >/dev/null
  docker volume inspect "$NIX_CACHE_VOLUME" >/dev/null 2>&1 || docker volume create "$NIX_CACHE_VOLUME" >/dev/null
}

compose() {
  local files=(-f "$ROOT/.box/compose.yml")
  [ "$(env_get ENABLE_SSH)" = true ] && files+=(-f "$ROOT/.box/compose.ssh.yml")
  docker compose "${files[@]}" "$@"
}

memory_compose() { docker compose -f "$ROOT/.box/memory.compose.yml" --env-file "$ROOT/.box/.env" "$@"; }

build() { # [extra docker build flags for the agents image]
  info "building base image"
  docker build ${PULL:+--pull} -t "$BOX_BASE_IMAGE" \
    --build-arg USER_UID="$USER_UID" --build-arg USER_GID="$USER_GID" \
    -f "$ROOT/Dockerfile" "$ROOT"
  info "building agents image"
  compose build "$@" dev
}

memory_up() {
  if [ -n "$(docker ps -q --filter "label=com.docker.compose.project=$MEMORY_PROJECT" --filter status=running)" ]; then
    return
  fi
  info "starting shared agentmemory"
  memory_compose up -d --wait
}

wait_ready() {
  for _ in $(seq 1 180); do
    compose logs dev 2>/dev/null | grep -q '\[box\] ready' && return
    sleep 1
  done
  die "container did not become ready; check: docker compose -f .box/compose.yml logs dev"
}

cmd_up() {
  prepare
  build
  memory_up
  compose up -d dev
  wait_ready
  info "ready"
  echo "  ./dev shell      terminal in the container"
  echo "  ./dev code       VS Code in the container (or: Reopen in Container)"
  echo "  memory viewer    http://localhost:3113"
  [ "${1:-}" = --code ] && cmd_code
  return 0
}

cmd_down() { prepare; compose down; }

cmd_shell() { prepare; compose exec -it dev bash; }

cmd_code() {
  command -v code >/dev/null || die "VS Code CLI 'code' not on PATH; open this folder in VS Code and run 'Dev Containers: Reopen in Container'"
  local folder hex
  folder=$ROOT
  command -v cygpath >/dev/null && folder=$(cygpath -w "$ROOT")
  hex=$(printf %s "$folder" | od -An -tx1 | tr -d ' \n')
  code --folder-uri "vscode-remote://dev-container+$hex/workspace"
}

cmd_rebuild() {
  prepare
  PULL=1 build --no-cache
  memory_up
  compose up -d --force-recreate dev
  wait_ready
  info "rebuilt. The shared memory server still runs its old image; restart it with ./dev memory restart"
}

cmd_update() {
  prepare
  compose run --rm --no-deps -T dev box-update /workspace
}

cmd_init() {
  local target=${1:-}
  [ -n "$target" ] || die "usage: ./dev init <path>"
  mkdir -p "$target"
  target=$(cd "$target" && pwd)
  local user=()
  [ "$(uname -s)" = Linux ] && user=(--user "$(id -u):$(id -g)")
  docker run --rm "${user[@]}" \
    -v "$(host_path "$ROOT"):/src:ro" -v "$(host_path "$target"):/dst" \
    debian:trixie-slim bash /src/.box/runtime/bin/box-apply-template /src /dst
  cp "$ROOT/.box/template.lock" "$target/.box/template.lock"
  info "initialized $target; next: cd there and run ./dev up"
}

# Hidden helpers.
cmd_connect() { prepare; compose exec -T dev box-connect; }

cmd_memory() {
  prepare
  case "${1:-}" in
    up) memory_up ;;
    down) memory_compose down ;;
    restart) memory_compose up -d --wait --force-recreate ;;
    logs) memory_compose logs -f ;;
    *) die "usage: ./dev memory up|down|restart|logs" ;;
  esac
}

main() {
  local cmd=${1:-help}
  shift || true
  case "$cmd" in
    up | down | shell | code | rebuild | update | init | connect | memory) "cmd_$cmd" "$@" ;;
    help | -h | --help) usage ;;
    *) usage; exit 1 ;;
  esac
}

# Single line on purpose: `./dev update` may rewrite this file while it runs.
main "$@"; exit
